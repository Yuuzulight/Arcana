+/// The child frame a `Runtime` or `DOM` command is about, if it is not about the page itself: the
+/// frame that holds the object the command names, else the frame of the execution context it names.
+fn target_frame(req: &CdpRequest, ctx: &CdpContext) -> Option<u32> {
+    if !matches!(req.method.split('.').next(), Some("Runtime" | "DOM")) {
+        return None;
+    }
+    if let Some(object_id) = req.params.get("objectId").and_then(|value| value.as_str()) {
+        return obscura_js::runtime::ObscuraJsRuntime::frame_of_object_id(object_id);
+    }
+    let by_id = ["contextId", "executionContextId"]
+        .iter()
+        .find_map(|key| req.params.get(*key).and_then(|value| value.as_i64()))
+        .and_then(|id| ctx.context_by_id(id));
+    let by_unique = req
+        .params
+        .get("uniqueContextId")
+        .and_then(|value| value.as_str())
+        .and_then(|unique| ctx.context_by_unique_id(unique));
+    let record = by_id.or(by_unique)?;
+    ctx.get_session_page(&req.session_id)?.frame_number(&record.frame_id)
+}

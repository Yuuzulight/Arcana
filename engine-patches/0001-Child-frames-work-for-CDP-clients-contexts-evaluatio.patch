+/// Turns a frameset document into a body of iframes, so its frames load, run and can be read like
+/// any other frame. The rows/cols layout is not kept; the frames come out in document order.
+const FRAMESET_TO_IFRAMES: &str = r#"(function() {
+  var sets = document.querySelectorAll('frameset');
+  if (!sets.length) return;
+  var body = document.body;
+  if (!body || body.localName !== 'body') {
+    body = document.createElement('body');
+    document.documentElement.appendChild(body);
+  }
+  var frames = sets[0].querySelectorAll('frame');
+  for (var i = 0; i < frames.length; i++) {
+    var frame = frames[i];
+    var iframe = document.createElement('iframe');
+    var names = ['name', 'id', 'scrolling', 'frameborder', 'title'];
+    for (var j = 0; j < names.length; j++) {
+      if (frame.hasAttribute(names[j])) iframe.setAttribute(names[j], frame.getAttribute(names[j]));
+    }
+    iframe.setAttribute('width', '100%');
+    iframe.setAttribute('height', '300');
+    body.appendChild(iframe);
+    if (frame.hasAttribute('src')) iframe.setAttribute('src', frame.getAttribute('src'));
+  }
+  if (sets[0].parentNode) sets[0].parentNode.removeChild(sets[0]);
+})();"#;

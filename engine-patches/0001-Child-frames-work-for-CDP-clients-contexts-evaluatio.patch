+    pub fn frame_of_object_id(object_id: &str) -> Option<u32> {
+        let rest = object_id.split("\"injectedScriptId\":").nth(1)?;
+        let digits: String = rest.chars().take_while(|c| c.is_ascii_digit()).collect();
+        let script: u32 = digits.parse().ok()?;

diff --git a/crates/obscura-net/src/form_body.rs b/crates/obscura-net/src/form_body.rs
new file mode 100644
index 0000000..3e19e3d
--- /dev/null
+++ b/crates/obscura-net/src/form_body.rs
@@ -0,0 +1,55 @@
+//! A form body the page hands to the network layer.
+//!
+//! A navigation carries its body as text, which is right for a urlencoded form and wrong for multipart:
+//! file bytes are not UTF-8, and the request needs a different content type. A multipart body therefore
+//! begins with a marker line naming its content type, and the rest is a binary string, one character per
+//! byte. These two functions turn that into the bytes and the content type to send.
+
+const MARKER: &[u8] = b"\0OBSCURA-CT:";
+const URLENCODED: &str = "application/x-www-form-urlencoded";
+
+/// The bytes of a form body: a plain body as it is, a marked one with its binary string decoded.
+pub(crate) fn form_body_bytes(body: &str) -> Vec<u8> {
+    let bytes = body.as_bytes();
+    if !bytes.starts_with(MARKER) {
+        return bytes.to_vec();
+    }
+    let Some(newline) = body.find('\n') else {
+        return bytes.to_vec();
+    };
+    let mut out = bytes[..=newline].to_vec();
+    out.extend(body[newline + 1..].chars().map(|c| c as u32 as u8));
+    out
+}
+
+/// The content type and payload to send for a body made by [`form_body_bytes`].
+pub(crate) fn split_form_body(body: &[u8]) -> (String, &[u8]) {
+    if let Some(rest) = body.strip_prefix(MARKER) {
+        if let Some(newline) = rest.iter().position(|byte| *byte == b'\n') {
+            if let Ok(content_type) = std::str::from_utf8(&rest[..newline]) {
+                return (content_type.to_string(), &rest[newline + 1..]);
+            }
+        }
+    }
+    (URLENCODED.to_string(), body)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_plain_form_body_is_sent_urlencoded_and_unchanged() {
+        let bytes = form_body_bytes("a=1&b=%C3%A9");
+        assert_eq!(split_form_body(&bytes), (URLENCODED.to_string(), &b"a=1&b=%C3%A9"[..]));
+    }
+
+    #[test]
+    fn a_marked_body_keeps_its_content_type_and_every_byte() {
+        let text = "\0OBSCURA-CT:multipart/form-data; boundary=xyz\n--xyz\r\n\u{00ff}\u{0000}\u{0080}\r\n--xyz--\r\n";
+        let bytes = form_body_bytes(text);
+        let (content_type, payload) = split_form_body(&bytes);
+        assert_eq!(content_type, "multipart/form-data; boundary=xyz");
+        assert_eq!(payload, &b"--xyz\r\n\xff\x00\x80\r\n--xyz--\r\n"[..]);
+    }
+}

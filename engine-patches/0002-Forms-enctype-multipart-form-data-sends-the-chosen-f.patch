@@ -5371,6 +5382,28 @@ class Element extends Node {
     let targetUrl;
     try { targetUrl = new URL(action, baseUrl).href; } catch(e) { targetUrl = action; }
 
+    if (multipart) {
+      // The body is a binary string (one character per byte); the network layer reads the first line as
+      // the content type and sends the rest as bytes.
+      const boundary = '----ObscuraFormBoundary' + Math.random().toString(16).slice(2) + Date.now().toString(16);
+      const utf8 = (s) => unescape(encodeURIComponent(String(s)));
+      let body = '';
